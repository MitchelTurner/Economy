DATABASE_URL=postgresql://island:island@localhost:5432/island_ledger
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=island-ledger-receipts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4-20250514
EXTRACTION_PROVIDER=mock
ALLOW_MOCK_EXTRACTION=true
MAX_EXTRACTIONS_PER_DAY=50
RATE_LIMIT_AUTH=30
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_INVITE=30
JSON_BODY_LIMIT=6mb
INSIGHT_NARRATION=auto
NARRATION_MODEL=
RESEND_API_KEY=
MAIL_FROM=Island Ledger <noreply@islandledger.local>
MAIL_PROVIDER=
PUBLIC_MIN_HOUSEHOLDS=3
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
NODE_ENV=development
# Production requires CORS_ORIGIN + strong distinct JWT secrets (see DEPLOY.md).
# Health: GET /health (live), GET /health/ready (Postgres + Redis).
# Seed: SEED_DEMO=0 for reference-only (npm run db:seed:reference).
SEED_DEMO=1
# API container boot: off | reference | demo (see DEPLOY.md)
SEED_ON_BOOT=off
